                </rdf:Bag>
              </bqbiol:is>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
        <listOfReactants>
          <speciesReference species="tal_ext" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="tal_urine" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
            <apply>
              <times/>
              <ci> GFR </ci>
              <cn sbml:units="l_per_ml"> 0.001 </cn>
              <ci> fup_tal </ci>
              <ci> TALEX_f </ci>
              <ci> tal_ext </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
