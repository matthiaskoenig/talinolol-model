    <listOfReactions>
      <reaction sboTerm="SBO:0000655" id="TALIM" name="talinolol import" reversible="true" compartment="Vbaso">
        <listOfReactants>
          <speciesReference species="tal_ext" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="tal" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
            <apply>
              <divide/>
              <apply>
                <times/>
                <apply>
                  <divide/>
                  <apply>
                    <times/>
                    <ci> f_oatp1b1 </ci>
                    <ci> TALIM_Vmax </ci>
                  </apply>
                  <ci> TALIM_Km_tal </ci>
                </apply>
                <ci> Vli </ci>
                <apply>
                  <minus/>
                  <apply>
                    <times/>
                    <ci> fup_tal </ci>
                    <ci> tal_ext </ci>
                  </apply>
                  <ci> tal </ci>
                </apply>
              </apply>
              <apply>
                <plus/>
                <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                <apply>
                  <divide/>
                  <apply>
                    <times/>
                    <ci> fup_tal </ci>
                    <ci> tal_ext </ci>
                  </apply>
                  <ci> TALIM_Km_tal </ci>
                </apply>
                <apply>
                  <divide/>
                  <ci> tal </ci>
                  <ci> TALIM_Km_tal </ci>
                </apply>
              </apply>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction sboTerm="SBO:0000655" id="TALEX" name="talinolol bile export" reversible="false" compartment="Vapical">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>This could be via MDR1 or MRP2.
Using trick to track total amount of talinolol excreted in bile.</p>
          </body>
        </notes>
        <listOfReactants>
          <speciesReference species="tal" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="tal_bi" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> f_pgp </ci>
              <ci> TALEX_k </ci>
              <ci> Vli </ci>
              <ci> tal </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction sboTerm="SBO:0000655" id="TALEHC" name="talinolol enterohepatic circulation" reversible="false" compartment="Vduodenum">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>Transport of talinolol via bile to the intestinal lumen (duodenum). This is the
enterohepatic circulation of talinolol.</p>
            <p>Irreversible transport of talinolol via Mass-Action-Kinetics.</p>
            <p>This is a dummy process which allows to simulate cholocystectomy.</p>
          </body>
        </notes>
        <listOfReactants>
          <speciesReference species="tal_bi" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="tal_duodenum" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> f_EHC </ci>
              <ci> TALEX </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
