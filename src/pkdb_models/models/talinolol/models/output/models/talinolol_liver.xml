      <rateRule sboTerm="SBO:0000001" name="cumulative amount talinol bile" variable="Abile_tal">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>Calculated via integration of the talinol bile excretion rate.</p>
          </body>
